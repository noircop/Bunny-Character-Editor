# Стили для Layout
style bce_root:
    xfill True
    yfill True
    padding (0, 0)
    background None

style bce_header:
    xfill True
    ysize 130
    padding (0, 0)
    background BCE_ACCENT

style bce_footer:
    xfill True
    ysize 108
    padding (0, 0)
    background None

style bce_body:
    xfill True
    yfill True
    padding (0, 0)
    background None

# Стили для Оболочки
style bce_shell_header:
    xfill True
    xalign 0.5
    spacing 20

style bce_shell_spacer:
    ysize 20

# Колонки в оболочки
style bce_left_column:
    yfill True
    padding (0, 0)
    background None

style bce_right_column:
    xfill True
    yfill True
    background None